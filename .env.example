# Copiez ce fichier en « .env.local » (développement) ou renseignez ces variables chez votre hébergeur.
# Ne publiez JAMAIS vos vraies clés (le fichier .env.local est ignoré par git).

# URL publique du site (après choix du nom de domaine) — utilisée pour le SEO, le sitemap et les retours de paiement
NEXT_PUBLIC_SITE_URL=https://www.exemple.be

# Adresse e-mail publique affichée sur le site (laisser vide tant qu'elle n'existe pas)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Formulaire de devis : envoi des e-mails via Resend (https://resend.com) ---
RESEND_API_KEY=
# Adresse qui RÉCOIT les demandes (plusieurs adresses possibles, séparées par des virgules)
CONTACT_TO_EMAIL=
# Expéditeur sur un domaine vérifié dans Resend, ex. « LN Digital <site@votre-domaine.be> »
CONTACT_FROM_EMAIL=

# --- Paiement en ligne : Stripe Checkout (https://stripe.com) ---
# Commencez avec une clé de TEST (sk_test_...). Le paiement n'est actif que si CHECKOUT_ENABLED=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_ENABLED=false
